# Copy this file to .env and fill in your own local values.
# Never commit the real .env file — it is ignored by git.

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/japjap

# ---- Auth ----
# Generate your own local secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_MINUTES=60

# ---- AI (Google Gemini) ----
# Obtain your own key from https://ai.google.dev/ — do not share or commit it.
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Speech-to-Text (Phase 9: GeminiSTTProvider) ----
# The default STTProvider (GeminiSTTProvider) uses the Gemini API's audio
# input support, so this can be the same key as GEMINI_API_KEY above or a
# separate one — kept as its own setting so speech features can be enabled/
# disabled independently of the AI tutor/generation features.
STT_API_KEY=your_stt_api_key_here

# ---- Backend ----
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
